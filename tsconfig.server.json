{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "rootDir": ".",
    "outDir": "server-dist",
    "sourceMap": true
  },
  "include": ["server/**/*.ts", "src/shared/**/*.ts", "src/lib/summary.ts"],
  "exclude": ["server/**/*.test.ts"]
}
